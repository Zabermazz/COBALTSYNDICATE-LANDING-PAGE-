NEXT_PUBLIC_SITE_URL=https://your-domain.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GIVEAWAY_ADMIN_TOKEN=

# Telegram education: server-side secrets. Never prefix these with NEXT_PUBLIC_.
# Use the exact production origin (https://example.com), without a trailing path.
APP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric chat IDs; membership in ANY listed chat grants access.
TELEGRAM_PREMIUM_CHAT_IDS=
TELEGRAM_JOIN_URL=https://t.me/zabermazz
TELEGRAM_SUPPORT_URL=https://t.me/zabermazz
# Generate separate random secrets of at least 32 characters.
AUTH_SECRET=
# Successful membership checks are cached for 1–30 minutes. Default: 30.
MEMBERSHIP_CACHE_MINUTES=30
